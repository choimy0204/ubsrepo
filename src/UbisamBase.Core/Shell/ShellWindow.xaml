<Window x:Class="UbisamBase.Core.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:messaging="clr-namespace:UbisamBase.Core.Messaging"
        xmlns:locking="clr-namespace:UbisamBase.Core.Locking"
        xmlns:screensaving="clr-namespace:UbisamBase.Core.ScreenSaving"
        xmlns:shell="clr-namespace:UbisamBase.Core.Shell"
        Title="{Binding Title}"
        Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Ubisam.Brush.ContentBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UbisamBase.Core;component/Themes/ShellStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 상단 브랜딩 바 전용 소형 아이콘 버튼(스크린샷/로그/창모드로). 하단 네비게이션 항목과 달리
                 탭처럼 보일 필요가 없어 크롬을 최소화한 전용 스타일을 쓴다. -->
            <Style x:Key="Ubisam.Style.TopBarIconButton" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Ubisam.Brush.Sidebar.Foreground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ubisam.Brush.Sidebar.HoverBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <DockPanel TextElement.Foreground="{DynamicResource Ubisam.Brush.ContentForeground}"
                   TextElement.FontFamily="{StaticResource Ubisam.Font.Body}"
                   TextElement.FontSize="15">

            <!-- 상단 브랜딩 바: 좌측 = 로고 + 회사명 + 장비명, 우측 = 날짜 + 시계, 그 뒤 유틸리티 버튼.
                 플랫폼 고정 요소 — 모듈이 건드리지 않는다. -->
            <Border x:Name="BrandBar"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource Ubisam.Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Ubisam.Brush.SubTabBar.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="26,14"
                    MouseLeftButtonDown="BrandBar_MouseLeftButtonDown">
                <Border.Visibility>
                    <!-- 발표자 모드(PlatformChrome.IsVisible)와 UI 설정의 "상단 바 접기"를 함께 본다 —
                         둘 중 하나라도 숨기라고 하면 숨는다. -->
                    <MultiBinding Converter="{StaticResource AllBoolToVis}">
                        <Binding Path="(shell:PlatformChrome.IsVisible)"/>
                        <Binding Path="UiSettings.TopBarVisible"/>
                    </MultiBinding>
                </Border.Visibility>
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiSettings.ChromeScale}" ScaleY="{Binding UiSettings.ChromeScale}"/>
                </Border.LayoutTransform>
                <!-- Grid.ColumnDefinitions 없이 한 셀에 세 그룹을 Left/Center/Right로 배치한다 —
                     그래야 가운데 버튼 그룹이 제목·시계 폭에 상관없이 항상 바 정중앙에 온다
                     (Auto 컬럼 사이에 끼우면 제목 길이에 따라 중심이 밀린다). -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- 아이콘+워드마크가 합쳐진 로고 이미지. 테마가 바뀌면 UiSettingsService.ApplyTheme가
                             Ubisam.Logo.Dark/.Light 중 하나로 다시 꽂아주므로 DynamicResource로 참조해야 한다. -->
                        <!-- 원본이 3533×829px라 30px 높이로 줄일 때 기본 스케일링으로는 계단현상이 심하게
                             보인다 — HighQuality로 지정해야 축소 시 부드럽게 나온다. -->
                        <Image Source="{DynamicResource Ubisam.Logo}"
                               Height="30"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <Border Width="1" Height="24" Margin="14,0"
                                Background="{DynamicResource Ubisam.Brush.SubTabBar.Border}"/>

                        <!-- 장비명: IAppSetup.GetAppName()이 돌려주는 값 -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   Foreground="{DynamicResource Ubisam.Brush.Sidebar.Foreground}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 로그 / 캡처(스크린샷) / 모드 변경(전체화면 토글) — 상단 바 정중앙. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="LogButton"
                                Style="{StaticResource Ubisam.Style.TopBarIconButton}"
                                ToolTip="로그"
                                Click="LogButton_Click">
                            <Path Data="{StaticResource Ubisam.Icon.Log}"
                                  Stroke="{DynamicResource Ubisam.Brush.Sidebar.Foreground}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="19" Height="19" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="ScreenshotButton"
                                Style="{StaticResource Ubisam.Style.TopBarIconButton}"
                                ToolTip="캡처"
                                Click="ScreenshotButton_Click">
                            <Path Data="{StaticResource Ubisam.Icon.Camera}"
                                  Stroke="{DynamicResource Ubisam.Brush.Sidebar.Foreground}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="19" Height="19" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="FullscreenButton"
                                Style="{StaticResource Ubisam.Style.TopBarIconButton}"
                                ToolTip="모드 변경"
                                Click="FullscreenButton_Click">
                            <Path x:Name="FullscreenIconPath"
                                  Data="{StaticResource Ubisam.Icon.FullscreenExit}"
                                  Stroke="{DynamicResource Ubisam.Brush.Sidebar.Foreground}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="19" Height="19" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                        <TextBlock Text="{Binding CurrentDate}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Ubisam.Brush.Muted}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,12,2"/>
                        <TextBlock Text="{Binding CurrentTime}"
                                   FontFamily="{StaticResource Ubisam.Font.Heading}"
                                   FontWeight="SemiBold"
                                   FontSize="25"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 네비게이션: 기본은 하단(NavPosition.Bottom). 좌/우 전환은 코드비하인드가 처리 -->
            <ListBox x:Name="NavList"
                      DockPanel.Dock="Bottom"
                      Visibility="{Binding Path=(shell:PlatformChrome.IsVisible), Converter={StaticResource BoolToVis}}"
                      Style="{StaticResource Ubisam.Style.SidebarBar.Horizontal}">
                <ListBox.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiSettings.ChromeScale}" ScaleY="{Binding UiSettings.ChromeScale}"/>
                </ListBox.LayoutTransform>
            </ListBox>

            <!-- 컨텐츠 + 하단 서브탭. 컨텐츠는 여백 없이 영역 전체를 쓴다 —
                 내부 여백은 각 모듈 View가 직접 정한다. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 모듈이 마운트되기 전에는 사선 해치가 빈 슬롯을 표시, 마운트되면 단색 배경.
                     여백은 발표자 모드에서 0이 된다 — 껍데기를 걷었는데 액자처럼 테두리가 남으면 안 된다. -->
                <Border Grid.Row="0"
                        Padding="{Binding Path=(shell:PlatformChrome.IsVisible), Converter={StaticResource BoolToContentPadding}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Ubisam.Brush.ContentBackground}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMainTab.CurrentContent}" Value="{x:Null}">
                                    <Setter Property="Background" Value="{DynamicResource Ubisam.Brush.SlotHatch}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl Content="{Binding SelectedMainTab.CurrentContent}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>
                </Border>

                <!-- 토스트 오버레이. 콘텐츠와 같은 Row(0)에 둬서 상단 브랜딩 바·하단 서브탭 줄은
                     절대 침범하지 않고 콘텐츠 영역 안에서만 뜬다. 정렬/여백은 UiSettings.ToastPosition에
                     따라 코드비하인드(ApplyToastPosition)가 정한다. -->
                <ItemsControl x:Name="ToastList"
                              Grid.Row="0"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsSource>
                        <Binding Path="Messages" Source="{x:Static messaging:ToastService.Current}"/>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Ubisam.Brush.Toast.Background}"
                                    BorderBrush="{DynamicResource Ubisam.Brush.Toast.Border}"
                                    BorderThickness="1"
                                    MinWidth="280" MaxWidth="380"
                                    Margin="0,0,0,8"
                                    Effect="{DynamicResource Ubisam.Effect.Toast}"
                                    Loaded="ToastItem_Loaded"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <!-- x:Name이 있어야 WPF가 이 Freezable을 템플릿 공유 최적화로 자동으로 얼리지 않는다 —
                                         얼리면(Frozen) 코드비하인드의 BeginAnimation이 "봉인된 개체" 예외로 죽는다. -->
                                    <TranslateTransform x:Name="SlideTransform"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding Type, Converter={StaticResource ToastTypeToBrush}}"/>

                                    <Path Grid.Column="1"
                                          Data="{Binding Type, Converter={StaticResource ToastTypeToGeometry}}"
                                          Stroke="{Binding Type, Converter={StaticResource ToastTypeToBrush}}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="19" Height="19"
                                          Margin="12,12,10,0"
                                          VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Text}"
                                               Foreground="{DynamicResource Ubisam.Brush.ContentForeground}"
                                               FontSize="13"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,12,14,12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox Grid.Row="1"
                          Style="{StaticResource Ubisam.Style.SubTabBar}"
                          DisplayMemberPath="Title"
                          ItemsSource="{Binding SelectedMainTab.SubTabs}"
                          SelectedItem="{Binding SelectedMainTab.SelectedSubTab, Mode=TwoWay}">
                    <ListBox.Visibility>
                        <MultiBinding Converter="{StaticResource AllBoolToVis}">
                            <Binding Path="(shell:PlatformChrome.IsVisible)"/>
                            <Binding Path="SelectedMainTab.HasSubTabs"/>
                        </MultiBinding>
                    </ListBox.Visibility>
                    <ListBox.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding UiSettings.ChromeScale}" ScaleY="{Binding UiSettings.ChromeScale}"/>
                    </ListBox.LayoutTransform>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- 스크린 세이버 — 특정 동작 진행 중 조작을 막는 반투명 오버레이. 인증 없이 코드에서
             자유롭게 켜고 끌 수 있다(화면 잠금과는 별개 개념). -->
        <screensaving:ScreenSaverOverlay
            Visibility="{Binding IsActive, Source={x:Static screensaving:ScreenSaverService.Current}, Converter={StaticResource BoolToVis}}"/>

        <!-- 화면 잠금. 마지막 자식이라 토스트·스크린 세이버를 포함한 다른 모든 것을 덮는다. -->
        <locking:LockOverlay
            Visibility="{Binding IsLocked, Source={x:Static locking:LockService.Current}, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
