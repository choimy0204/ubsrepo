<Window x:Class="UbisamBase.Core.Locking.LockConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Ubisam.Brush.ContentBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 별도 창이라 셸의 리소스를 자동 상속받지 못한다 — ShellStyles.xaml을 직접 머지한다.
         MessageDialog.xaml과 같은 이유/같은 패턴. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UbisamBase.Core;component/Themes/ShellStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- PasswordBox는 Controls.xaml의 암시적 TextBox 스타일을 받지 못한다(다른 타입이라서) —
                 LockOverlay.xaml/LockSettingsView.xaml과 같은 모양으로 여기서도 따로 정의한다. -->
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontFamily" Value="{DynamicResource Ubisam.Font.Body}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource Ubisam.Brush.ContentForeground}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Ubisam.Brush.Accent}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource Ubisam.Brush.Input.Background}"
                                    BorderBrush="{DynamicResource Ubisam.Brush.Input.Border}"
                                    BorderThickness="1.5"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ubisam.Brush.Input.BorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ubisam.Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Ubisam.Brush.SubTabBar.Border}" BorderThickness="1">
        <DockPanel TextElement.Foreground="{DynamicResource Ubisam.Brush.ContentForeground}">
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource Ubisam.Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Ubisam.Brush.SubTabBar.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="화면 잠금"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Ubisam.Brush.ContentForeground}"/>
            </Border>

            <StackPanel Margin="20">
                <TextBlock Text="여기서 입력한 아이디/비밀번호가 해제 키가 됩니다. 잠금을 풀 때 같은 값을 입력해야 합니다." TextWrapping="Wrap"
                           Foreground="{DynamicResource Ubisam.Brush.Muted}"
                           FontSize="12.5" Margin="0,0,0,16"/>

                <TextBlock Text="아이디" Margin="0,0,0,6"/>
                <TextBox x:Name="IdBox" Foreground="{DynamicResource Ubisam.Brush.ContentForeground}" Margin="0,0,0,14"/>

                <TextBlock Text="비밀번호" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBoxInput" Foreground="{DynamicResource Ubisam.Brush.ContentForeground}" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Ubisam.Brush.Danger}"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           Margin="0,0,0,4"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="취소"
                            MinWidth="84"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="LockButton"
                            Content="잠금"
                            Style="{StaticResource Ubisam.Style.Button.Primary}"
                            MinWidth="84"
                            Padding="14,7"
                            IsDefault="True"
                            Click="Lock_Click"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
