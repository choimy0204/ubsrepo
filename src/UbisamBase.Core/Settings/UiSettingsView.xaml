<UserControl x:Class="UbisamBase.Core.Settings.UiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UbisamBase.Core.SettingItems"
             mc:Ignorable="d">
    <StackPanel>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="UI 설정" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <local:SettingsToolbar Grid.Column="1"/>
        </Grid>

        <TextBlock Text="테마" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox ItemsSource="{Binding ThemeOptions}"
                  SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                  MaxWidth="320" HorizontalAlignment="Left"
                  Margin="0,0,0,24">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="네비게이션 위치" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox ItemsSource="{Binding NavPositionOptions}"
                  SelectedItem="{Binding SelectedNavPositionOption, Mode=TwoWay}"
                  MaxWidth="320" HorizontalAlignment="Left"
                  Margin="0,0,0,24">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="상단 바" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <CheckBox Content="상단 바 접기(로고·시계 줄 숨김)"
                  IsChecked="{Binding TopBarCollapsed, Mode=TwoWay}"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,24"/>

        <TextBlock Text="토스트 메시지 위치" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox ItemsSource="{Binding ToastPositionOptions}"
                  SelectedItem="{Binding SelectedToastPositionOption, Mode=TwoWay}"
                  MaxWidth="320" HorizontalAlignment="Left"
                  Margin="0,0,0,24">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Margin="0,0,0,8">
            <Run Text="화면 배율 ("/>
            <Run Text="{Binding ChromeScalePercent, StringFormat={}{0:P0}, Mode=OneWay}"/>
            <Run Text=")"/>
        </TextBlock>
        <Slider Minimum="0.8" Maximum="1.6"
                TickFrequency="0.1" IsSnapToTickEnabled="True"
                SmallChange="0.05" LargeChange="0.1"
                Value="{Binding ChromeScalePercent, Mode=TwoWay}"
                Width="320" HorizontalAlignment="Left"
                Margin="0,0,0,24"/>

        <TextBlock Text="플랫폼 업데이트" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="사용" GroupName="UpdateEnabled"
                         IsChecked="{Binding UpdateEnabled, Mode=TwoWay}" Margin="0,0,24,0"/>
            <RadioButton Content="사용 안 함" GroupName="UpdateEnabled"
                         IsChecked="{Binding UpdateEnabled, Converter={StaticResource InverseBool}, Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,24" IsEnabled="{Binding UpdateEnabled}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="자동으로 업데이트" GroupName="UpdateAuto"
                             IsChecked="{Binding UpdateAuto, Mode=TwoWay}" Margin="0,0,24,0"/>
                <RadioButton Content="업데이트할지 물어보기" GroupName="UpdateAuto"
                             IsChecked="{Binding UpdateAuto, Converter={StaticResource InverseBool}, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="저장소 주소" Foreground="{DynamicResource Ubisam.Brush.Muted}" Margin="0,4,0,6"/>
            <TextBox Text="{Binding UpdateRepositoryUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     MaxWidth="520" MinWidth="320" HorizontalAlignment="Left"/>
            <TextBlock Foreground="{DynamicResource Ubisam.Brush.Muted}" Margin="0,8,0,0">
                <Run Text="지금 설치된 플랫폼 버전: "/>
                <Run Text="{Binding InstalledPlatformVersion, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="실행할 때 저장소의 업데이트 파일과 비교해, 새 버전이 있으면 받아서 켭니다."
                       Foreground="{DynamicResource Ubisam.Brush.Muted}"
                       TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Visibility="{Binding HasLanguages, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="언어" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding AvailableCultures}"
                      SelectedItem="{Binding CurrentCulture, Mode=TwoWay}"
                      MaxWidth="320" HorizontalAlignment="Left"/>
        </StackPanel>
    </StackPanel>
</UserControl>
