<UserControl x:Class="UbisamBase.Core.Cleaning.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UbisamBase.Core.SettingItems"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 경로처럼 긴 텍스트 열은 가운데 정렬 기본값 대신 왼쪽 정렬이 읽기 편하다 -->
        <Style x:Key="LeftAlignedCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="클리너" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <local:SettingsToolbar Grid.Column="1"/>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="규칙별로 폴더를 지정해 기한이 지난 파일(확장자 기준)이나 이름에 날짜가 포함된 하위 폴더를 매일 자정 자동으로 지웁니다. 경로/확장자/폴더삭제를 고치면 '미적용'으로 바뀌니, 다시 '적용'을 눌러야 실제로 실행됩니다."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Path Data="M12,7 L12,12.5 L15.8,14.5 M3,12 A9,9 0 0 1 21,12 A9,9 0 0 1 3,12 Z"
                  Stroke="{DynamicResource Ubisam.Brush.Muted}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="다음 자동 실행까지 " Opacity="0.7" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding NextRunText}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ubisam.Brush.Accent}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="지금 실행" Command="{Binding RunNowCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="규칙 추가" Command="{Binding AddRuleCommand}" Padding="14,6"/>
        </StackPanel>

        <!-- 규칙이 하나도 없으면 빈 DataGrid만 덩그러니 보이지 않도록, 같은 자리에 안내 문구를 겹쳐 둔다. -->
        <Grid>
            <DataGrid x:Name="RulesGrid"
                      ItemsSource="{Binding Rules}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CellEditEnding="RulesGrid_CellEditEnding">
                <DataGrid.Columns>
                    <!-- 토글 자체가 52px 폭(트랙)인데 DataGridCell 기본 좌우 패딩이 11px씩이라,
                         컬럼을 그보다 좁게 잡으면 셀 경계에 토글 오른쪽이 잘려 보인다(초승달처럼 보이는 원인) —
                         52 + 11*2 = 74 이상은 돼야 한다. -->
                    <DataGridTemplateColumn Header="사용" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="폴더 경로" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*" CellStyle="{StaticResource LeftAlignedCell}"/>
                    <DataGridTextColumn Header="확장자" Binding="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" Width="70">
                        <!-- 폴더삭제 모드에서는 확장자가 아무 의미가 없다 — Aurora 원본처럼 흐리게 표시해
                             "이 칸은 지금 안 쓰인다"는 걸 눈으로 바로 알 수 있게 한다. -->
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolderMode}" Value="True">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="기한(일)" Binding="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridCheckBoxColumn Header="폴더삭제" Binding="{Binding IsFolderMode}" Width="60"/>
                    <DataGridTemplateColumn Header="상태" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Ubisam.Brush.Danger}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Applied}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ubisam.Brush.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="마지막 삭제" Binding="{Binding LastDeleted}" Width="130" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="적용" Width="90" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 행 높이가 42px 고정(전역 DataGrid.RowHeight)이라 세로 여백을 최소로 줘야
                                     버튼 글자가 위아래로 잘리지 않는다 — Margin 세로값을 두지 않고
                                     VerticalAlignment=Center로 셀 안에서 가운데 맞춘다. -->
                                <Button Content="적용"
                                        Command="{Binding DataContext.ApplyRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2" Margin="4,0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="삭제" Width="90" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="삭제"
                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2" Margin="4,0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVis}}">
                <Path Data="M3,7 L3,5 A1,1 0 0 1 4,4 L9,4 L11,7 L20,7 A1,1 0 0 1 21,8 L21,19 A1,1 0 0 1 20,20 L4,20 A1,1 0 0 1 3,19 Z"
                      Stroke="{DynamicResource Ubisam.Brush.Muted}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="40" Height="40" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="등록된 클리너 규칙이 없습니다." Opacity="0.6" HorizontalAlignment="Center"/>
                <TextBlock Text="아래 '규칙 추가' 버튼으로 시작하세요." Opacity="0.6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
