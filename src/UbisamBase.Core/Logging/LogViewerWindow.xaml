<Window x:Class="UbisamBase.Core.Logging.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UbisamBase.Core.Logging"
        Title="로그"
        Width="1440" Height="860"
        MinWidth="480" MinHeight="280"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Ubisam.Brush.ContentBackground}">

    <!-- 별도 창이라 셸 리소스를 자동 상속받지 못한다 — ShellStyles.xaml을 직접 머지한다(LockConfirmDialog와 동일 패턴). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UbisamBase.Core;component/Themes/ShellStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Ubisam.Brush.SubTabBar.Border}" BorderThickness="1">
        <DockPanel TextElement.Foreground="{DynamicResource Ubisam.Brush.ContentForeground}">
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource Ubisam.Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Ubisam.Brush.SubTabBar.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Padding="8,2"
                            Click="Close_Click"/>
                    <TextBlock Text="로그" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ubisam.Brush.ContentForeground}"/>
                </DockPanel>
            </Border>

            <local:LogViewerView x:Name="Viewer"/>
        </DockPanel>
    </Border>
</Window>
