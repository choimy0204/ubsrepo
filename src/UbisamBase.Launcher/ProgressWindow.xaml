<Window x:Class="UbisamBase.Launcher.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Barlow, Segoe UI"
        FontSize="14"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- 업데이트 안내창(UpdateDialog)과 같은 언어: 위 accent 띠, accent 칩 아이콘, 한 판 구성.
         버튼이 없다 — 확인/취소는 받기가 끝난 뒤 UpdateDialog에서 묻는다. -->
    <Border x:Name="RootBorder" BorderThickness="1">
        <DockPanel>
            <Border x:Name="AccentStrip" DockPanel.Dock="Top" Height="3"/>

            <StackPanel Margin="26,22,26,22">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconChip" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,14,0">
                        <Path x:Name="IconPath"
                              Data="M12,4 L12,14.5 M7.2,10 L12,15 L16.8,10 M5.5,19 L18.5,19"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeadlineText"
                                   Text="업데이트 확인 중"
                                   FontFamily="Barlow Condensed, Segoe UI"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="저장소에서 최신 버전을 확인하고 있습니다."
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 진행 막대 — 기본 ProgressBar 대신 직접 그린다(테마 색을 그대로 쓰기 위함). -->
                <Border x:Name="TrackBorder" Height="6" CornerRadius="3" Margin="0,18,0,0" HorizontalAlignment="Stretch">
                    <Border x:Name="FillBorder" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                </Border>

                <TextBlock x:Name="PercentText"
                           Text="0%"
                           FontSize="11.5"
                           HorizontalAlignment="Right"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
