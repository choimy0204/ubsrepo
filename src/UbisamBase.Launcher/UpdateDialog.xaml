<Window x:Class="UbisamBase.Launcher.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Barlow, Segoe UI"
        FontSize="14"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 제목줄 없이 한 판으로 가고, 위쪽 accent 띠 하나로 플랫폼 창임을 표시한다.
         Core의 리소스를 쓸 수 없어(참조하면 갱신 대상 Core.dll을 물게 된다) 색은 코드비하인드가
         시스템 테마(밝게/어둡게)에 맞춰 직접 넣는다. -->
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 보조 동작은 테두리 없는 글자 버튼 — 눈이 "업데이트" 쪽으로 먼저 가게 한다. -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding QuietHoverBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderThickness="1">
        <DockPanel>
            <!-- 위쪽 accent 띠 -->
            <Border x:Name="AccentStrip" DockPanel.Dock="Top" Height="3"/>

            <StackPanel Margin="26,24,26,20">

                <!-- 제목줄: 아이콘 칩 + 제목/한 줄 설명 -->
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconChip" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="0,0,16,0">
                        <!-- 아래로 내려받는 화살표 -->
                        <Path x:Name="IconPath"
                              Data="M12,4 L12,14.5 M7.2,10 L12,15 L16.8,10 M5.5,19 L18.5,19"
                              Width="22" Height="22"
                              Stretch="Uniform"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeadlineText"
                                   Text="새 버전이 준비됐습니다"
                                   FontFamily="Barlow Condensed, Segoe UI"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubText"
                                   Text="플랫폼을 최신으로 바꾼 뒤 실행합니다."
                                   FontSize="13"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 버전 비교: 지금 → 새것 -->
                <Border x:Name="VersionBox" CornerRadius="8" Padding="16,13" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="CurrentLabel" Text="지금" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentValue" FontSize="13" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Path x:Name="ArrowPath"
                              Data="M4,10 L18,10 M13,5.5 L18,10 L13,14.5"
                              Width="22" Height="20"
                              Stretch="Uniform"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Margin="18,10,18,0"
                              VerticalAlignment="Center"/>

                        <StackPanel>
                            <TextBlock x:Name="NewLabel" Text="새 버전" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NewValue" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FootnoteText"
                           Text="나중에를 누르면 이번에는 지금 버전으로 실행하고, 다음에 다시 물어봅니다."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="2,14,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="NoButton" Content="나중에" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="No_Click"/>
                    <Button x:Name="YesButton" Content="지금 업데이트" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Yes_Click"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
