<Window x:Class="UbisamBase.Launcher.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Barlow, Segoe UI"
        FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Core의 MessageDialog와 같은 생김새지만 리소스를 공유하지 않는다 — Launcher가 Core를 참조하면
         갱신 대상인 Core.dll을 먼저 물고 있게 되어 덮어쓸 수 없기 때문이다(PlatformUpdater 주석 참고).
         그래서 색은 코드비하인드가 시스템 테마(밝게/어둡게)에 맞춰 직접 넣는다. -->
    <Window.Resources>
        <!-- 버튼: 채움색·글자색은 코드에서 넣고, 여기서는 모양과 hover 반응만 정의한다. -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderThickness="1">
        <DockPanel>

            <!-- 제목줄: 끌어서 창 이동 -->
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="UbisamBase 업데이트" FontWeight="SemiBold"/>
            </Border>

            <!-- 버튼줄: 예가 주 동작(accent 채움), 아니오가 보조(외곽선) -->
            <Border x:Name="ButtonBar"
                    DockPanel.Dock="Bottom"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton"
                            Content="나중에"
                            Style="{StaticResource DialogButton}"
                            Margin="0,0,8,0"
                            Click="No_Click"/>
                    <Button x:Name="YesButton"
                            Content="업데이트"
                            Style="{StaticResource DialogButton}"
                            IsDefault="True"
                            Click="Yes_Click"/>
                </StackPanel>
            </Border>

            <!-- 본문: 아이콘 + 안내문 + 버전 비교 -->
            <Grid Margin="20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="IconPath"
                      Grid.Column="0"
                      Data="M3,12 A9,9 0 0 1 21,12 A9,9 0 0 1 3,12 Z M9.3,9.3 A2.7,2.7 0 1 1 13.3,12.6 C12.5,13.1 12,13.6 12,14.8 M12,17.4 L12,17.5"
                      Width="24" Height="24"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      VerticalAlignment="Top"
                      Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadlineText"
                               Text="새 플랫폼 버전이 있습니다."
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CurrentLabel" Grid.Row="0" Grid.Column="0" Text="지금 버전" Margin="0,0,14,4"/>
                        <TextBlock x:Name="CurrentValue" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"/>
                        <TextBlock x:Name="NewLabel" Grid.Row="1" Grid.Column="0" Text="새 버전" Margin="0,0,14,0"/>
                        <TextBlock x:Name="NewValue" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock x:Name="FootnoteText"
                               Text="지금 받으면 새 버전으로 실행합니다. 나중에를 누르면 이번에는 그대로 실행하고, 다음에 다시 물어봅니다."
                               TextWrapping="Wrap"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
